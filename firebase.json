{
  "hosting": {
    "site": "camera-catcher-bigotes",
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules"
    },
    {
      "database": "test",
      "rules": "firestore.rules"
    }
  ],
  "storage": [
    {
      "target": "default",
      "rules": "storage.rules"
    },
    {
      "target": "test",
      "rules": "storage.rules"
    }
  ]
}
