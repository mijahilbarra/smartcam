rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Ecosistema IOT Camera Catcher (configuración, comandos, cuadrantes, telemetría y fotos)
    match /camera_catcher/{document=**} {
      allow read, write: if true;
    }

    // Directorio biométrico de clientes y personal (ArcFace embeddings y perfiles)
    match /camera_catcher_people/{personId} {
      allow read, write: if true;
    }

    // Por defecto denegar acceso a cualquier otra colección
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
